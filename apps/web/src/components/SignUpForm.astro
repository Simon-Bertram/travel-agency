---
---

<div class="mx-auto w-full max-w-md px-6 py-16">
  <div
    class="rounded-3xl border border-parchment-border bg-alabaster-card p-8 shadow-lg sm:p-10"
  >
    <div class="mb-8 text-center">
      <div class="mb-3 inline-flex items-center gap-2">
        <span class="h-px w-6 bg-champagne"></span>
        <span
          class="text-[11px] font-semibold uppercase tracking-[0.25em] text-champagne"
        >
          Client Register
        </span>
        <span class="h-px w-6 bg-champagne"></span>
      </div>
      <h1
        class="font-serif text-3xl font-normal tracking-tight text-atelier-teal sm:text-4xl"
      >
        Create your <span class="italic text-atelier-teal-light">account</span>
      </h1>
      <p class="mt-3 text-sm font-light leading-relaxed text-atelier-teal/70">
        Register for the traveler salon to commission private journeys.
      </p>
    </div>

    <form class="space-y-6" id="signup-form" novalidate>
      <div>
        <label
          class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-atelier-teal"
          for="signup-name"
        >
          Full Name <span class="text-champagne">*</span>
        </label>
        <input
          aria-invalid="false"
          autocomplete="name"
          class="w-full rounded-xl border border-atelier-teal/50 bg-alabaster px-4 py-3 text-sm text-atelier-teal placeholder-atelier-teal/30 transition-colors focus-visible:border-champagne-dark focus-visible:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-atelier-teal focus-visible:ring-offset-2 focus-visible:ring-offset-white"
          id="signup-name"
          name="name"
          placeholder="e.g. Lord Alistair Vance"
          required
          type="text"
        >
        <p
          class="mt-1 hidden text-[11px] font-medium text-rose-700"
          id="signup-name-error"
        ></p>
      </div>

      <div>
        <label
          class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-atelier-teal"
          for="signup-email"
        >
          Correspondence Email <span class="text-champagne">*</span>
        </label>
        <input
          aria-invalid="false"
          autocapitalize="none"
          autocomplete="email"
          class="w-full rounded-xl border border-atelier-teal/50 bg-alabaster px-4 py-3 text-sm text-atelier-teal placeholder-atelier-teal/30 transition-colors focus-visible:border-champagne-dark focus-visible:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-atelier-teal focus-visible:ring-offset-2 focus-visible:ring-offset-white"
          id="signup-email"
          name="email"
          placeholder="confidential@familyoffice.ch"
          required
          spellcheck="false"
          type="email"
        >
        <p
          class="mt-1 hidden text-[11px] font-medium text-rose-700"
          id="signup-email-error"
        ></p>
      </div>

      <div>
        <label
          class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-atelier-teal"
          for="signup-password"
        >
          Password <span class="text-champagne">*</span>
        </label>
        <input
          aria-describedby="signup-password-hint"
          aria-invalid="false"
          autocomplete="new-password"
          class="w-full rounded-xl border border-atelier-teal/50 bg-alabaster px-4 py-3 text-sm text-atelier-teal placeholder-atelier-teal/30 transition-colors focus-visible:border-champagne-dark focus-visible:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-atelier-teal focus-visible:ring-offset-2 focus-visible:ring-offset-white"
          id="signup-password"
          minlength="8"
          name="password"
          placeholder="At least 8 characters"
          required
          type="password"
        >
        <p
          class="mt-1 text-[11px] font-light text-atelier-teal/80"
          id="signup-password-hint"
        >
          Must be at least 8 characters.
        </p>
        <p
          class="mt-1 hidden text-[11px] font-medium text-rose-700"
          id="signup-password-error"
        ></p>
      </div>

      <p
        aria-atomic="true"
        aria-live="assertive"
        class="hidden text-sm font-medium text-rose-700"
        id="signup-form-error"
        role="alert"
      ></p>

      <button
        class="group inline-flex min-h-11 w-full items-center justify-center gap-3 rounded-full bg-atelier-teal px-8 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-alabaster transition-all duration-300 hover:bg-atelier-teal-light hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-champagne focus-visible:ring-offset-2 focus-visible:ring-offset-alabaster-card disabled:cursor-not-allowed disabled:opacity-50"
        id="signup-submit"
        type="submit"
      >
        <span id="signup-submit-label">Sign Up</span>
        <svg
          aria-hidden="true"
          class="h-4 w-4 text-champagne transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M14 5l7 7m0 0l-7 7m7-7H3"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </button>
    </form>
  </div>

  <p class="mt-6 text-center">
    <a
      class="inline-flex min-h-11 items-center px-3 text-sm text-atelier-teal/80 underline-offset-4 transition-colors hover:text-atelier-teal hover:underline focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-atelier-teal focus-visible:ring-offset-2"
      href="/login"
    >
      Already have an account? Sign In
    </a>
  </p>
</div>

<script>
  import { authClient } from "../lib/auth-client";

  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const DUPLICATE_ACCOUNT_PATTERN = /already exists/i;
  const MIN_PASSWORD_LENGTH = 8;

  const form = document.getElementById("signup-form");
  const nameInput = document.getElementById("signup-name");
  const emailInput = document.getElementById("signup-email");
  const passwordInput = document.getElementById("signup-password");
  const nameError = document.getElementById("signup-name-error");
  const emailError = document.getElementById("signup-email-error");
  const passwordError = document.getElementById("signup-password-error");
  const formError = document.getElementById("signup-form-error");
  const submitButton = document.getElementById("signup-submit");
  const submitLabel = document.getElementById("signup-submit-label");

  if (!(form instanceof HTMLFormElement)) {
    throw new Error("Sign-up form not found");
  }

  function isInput(el: Element | null): el is HTMLInputElement {
    return el instanceof HTMLInputElement;
  }

  function isParagraph(el: Element | null): el is HTMLParagraphElement {
    return el instanceof HTMLParagraphElement;
  }

  function setFieldError(
    input: HTMLInputElement,
    errorEl: HTMLParagraphElement,
    message: string | null,
    persistentDescribedBy?: string
  ) {
    if (message) {
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
      input.setAttribute("aria-invalid", "true");
      input.setAttribute(
        "aria-describedby",
        persistentDescribedBy
          ? `${persistentDescribedBy} ${errorEl.id}`
          : errorEl.id
      );
      input.classList.add("border-rose-700");
      return;
    }

    errorEl.textContent = "";
    errorEl.classList.add("hidden");
    input.setAttribute("aria-invalid", "false");
    if (persistentDescribedBy) {
      input.setAttribute("aria-describedby", persistentDescribedBy);
    } else {
      input.removeAttribute("aria-describedby");
    }
    input.classList.remove("border-rose-700");
  }

  function setFormError(message: string | null) {
    if (!isParagraph(formError)) {
      return;
    }

    if (message) {
      formError.textContent = message;
      formError.classList.remove("hidden");
      return;
    }

    formError.textContent = "";
    formError.classList.add("hidden");
  }

  function isDuplicateAccountError(error: {
    code?: string | undefined;
    message?: string | undefined;
  }) {
    const code = error.code ?? "";
    const message = error.message ?? "";
    return (
      code.includes("USER_ALREADY_EXISTS") ||
      DUPLICATE_ACCOUNT_PATTERN.test(message)
    );
  }

  function validateSignUp() {
    if (
      !(isInput(nameInput) && isInput(emailInput) && isInput(passwordInput))
    ) {
      return false;
    }
    if (
      !(
        isParagraph(nameError) &&
        isParagraph(emailError) &&
        isParagraph(passwordError)
      )
    ) {
      return false;
    }

    const name = nameInput.value.trim();
    const email = emailInput.value.trim();
    const password = passwordInput.value;
    let firstInvalid: HTMLInputElement | null = null;

    if (name) {
      setFieldError(nameInput, nameError, null);
    } else {
      setFieldError(nameInput, nameError, "Please enter your full name.");
      firstInvalid ??= nameInput;
    }

    if (!email) {
      setFieldError(emailInput, emailError, "Please enter your email address.");
      firstInvalid ??= emailInput;
    } else if (EMAIL_PATTERN.test(email)) {
      setFieldError(emailInput, emailError, null);
    } else {
      setFieldError(
        emailInput,
        emailError,
        "Please enter a valid email address."
      );
      firstInvalid ??= emailInput;
    }

    if (!password) {
      setFieldError(
        passwordInput,
        passwordError,
        "Please enter a password.",
        "signup-password-hint"
      );
      firstInvalid ??= passwordInput;
    } else if (password.length < MIN_PASSWORD_LENGTH) {
      setFieldError(
        passwordInput,
        passwordError,
        "Password must be at least 8 characters.",
        "signup-password-hint"
      );
      firstInvalid ??= passwordInput;
    } else {
      setFieldError(passwordInput, passwordError, null, "signup-password-hint");
    }

    firstInvalid?.focus();
    return firstInvalid === null;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    setFormError(null);

    if (!validateSignUp()) {
      return;
    }

    if (
      !(isInput(nameInput) && isInput(emailInput) && isInput(passwordInput))
    ) {
      return;
    }

    form.setAttribute("aria-busy", "true");
    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
    }
    if (submitLabel) {
      submitLabel.textContent = "Creating account...";
    }

    try {
      await authClient.signUp.email(
        {
          callbackURL: new URL("/dashboard", window.location.origin).href,
          email: emailInput.value.trim(),
          name: nameInput.value.trim(),
          password: passwordInput.value,
        },
        {
          onError: (ctx) => {
            if (ctx.error.status === 429) {
              setFormError(
                "Too many attempts. Please wait a moment and try again."
              );
              return;
            }

            if (isDuplicateAccountError(ctx.error)) {
              setFormError("An account with this email already exists.");
              return;
            }

            setFormError("Sign up failed. Please try again.");
          },
          onSuccess: () => {
            window.location.assign("/dashboard");
          },
        }
      );
    } catch {
      setFormError("Something went wrong. Please try again.");
    } finally {
      form.removeAttribute("aria-busy");
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
      }
      if (submitLabel) {
        submitLabel.textContent = "Sign Up";
      }
    }
  });
</script>
