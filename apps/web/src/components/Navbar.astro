---
import Brand from "./Brand.astro";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const navLinks = [
  { href: "#destinations", label: "Destinations" },
  { href: "#experiences", label: "Experiences" },
  { href: "#pillars", label: "The Atelier" },
  { href: "#journal", label: "Journal" },
  { href: "#inquire", label: "Private Enquire" },
];
---

<header
  class={`sticky top-0 z-40 w-full transition-all duration-300 border-b border-atelier-teal/10 bg-alabaster/90 backdrop-blur-md ${
    transparent ? "bg-opacity-90" : ""
  }`}
  id="main-nav"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-12"
  >
    <Brand />

    <!-- Desktop Navigation Links -->
    <nav
      class="hidden md:flex items-center gap-8 text-[13px] tracking-[0.14em] uppercase font-medium text-atelier-teal/80"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="relative py-1 transition-colors hover:text-black after:absolute after:bottom-0 after:left-0 after:h-[1.5px] after:w-0 after:bg-champagne after:transition-all after:duration-300 hover:after:w-full"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right Actions: Auth & CTA -->
    <div class="flex items-center gap-4">
      <!-- Session Menu (Client-side Better Auth) -->
      <div class="relative" id="nav-auth-container">
        <!-- Guest State -->
        <div class="flex items-center gap-3" id="nav-guest-state">
          <a
            class="hidden sm:inline-block text-[13px] tracking-wider uppercase text-atelier-teal/70 hover:text-black font-medium transition-colors"
            href="/login"
          >
            Sign In
          </a>
        </div>

        <!-- Authenticated State (Hidden initially) -->
        <div class="hidden relative" id="nav-user-state">
          <button
            aria-expanded="false"
            class="flex items-center gap-2 rounded-full border border-champagne/50 bg-black px-2.5 py-1 text-xs text-champagne hover:border-champagne transition-colors focus:outline-none"
            id="avatar-menu-button"
            type="button"
          >
            <span
              class="flex h-6 w-6 items-center justify-center rounded-full bg-champagne text-[11px] font-semibold text-black"
              id="user-initials"
            >
              T
            </span>
            <span
              class="hidden md:inline-block text-[12px] font-medium max-w-24 truncate"
              id="user-name-display"
            >
              Traveler
            </span>
            <svg
              aria-hidden="true"
              class="h-3.5 w-3.5 text-champagne"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M19 9l-7 7-7-7"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>
          </button>

          <!-- User Dropdown Menu -->
          <div
            class="hidden absolute right-0 mt-2 w-52 rounded-lg border border-champagne/60 bg-white p-2 shadow-xl z-50 animate-in fade-in slide-in-from-top-1 duration-200"
            id="user-dropdown-menu"
          >
            <div class="px-3 py-2 border-b border-champagne/60 mb-1">
              <p
                class="text-xs font-semibold text-black"
                id="dropdown-user-name"
              >
                Traveler
              </p>
              <p
                class="text-[11px] text-black/60 truncate"
                id="dropdown-user-email"
              >
                client@terranova.com
              </p>
            </div>
            <a
              class="flex items-center gap-2 rounded px-3 py-2 text-xs text-black hover:bg-champagne/10 transition-colors"
              href="/dashboard"
            >
              <svg
                aria-hidden="true"
                class="h-4 w-4 text-champagne"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                />
              </svg>
              Traveler Salon
            </a>
            <button
              class="w-full text-left flex items-center gap-2 rounded px-3 py-2 text-xs text-rose-700 hover:bg-rose-50 transition-colors"
              id="signout-trigger"
              type="button"
            >
              <svg
                aria-hidden="true"
                class="h-4 w-4 text-rose-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                />
              </svg>
              Sign Out
            </button>
          </div>
        </div>
      </div>

      <!-- Plan Your Journey CTA -->
      <a
        class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-[#0c3a3b] px-5 py-2 text-[12px] tracking-[0.16em] uppercase font-medium text-[#fbf9f6] transition-all duration-300 hover:bg-[#164f51] hover:shadow-lg shadow-sm"
        href="#inquire"
      >
        <span class="relative z-10">Plan Your Journey</span>
        <svg
          aria-hidden="true"
          class="relative z-10 h-3 w-3 text-champagne transition-transform duration-300 group-hover:translate-x-0.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M14 5l7 7m0 0l-7 7m7-7H3"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        aria-label="Toggle Navigation Menu"
        class="md:hidden flex h-9 w-9 items-center justify-center rounded-full border border-atelier-teal/20 text-black focus:outline-none"
        id="mobile-menu-button"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="h-5 w-5"
          fill="none"
          id="mobile-menu-icon"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M4 6h16M4 12h16M4 18h16"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    class="hidden md:hidden border-t border-atelier-teal/10 bg-white px-6 py-6 animate-in slide-in-from-top duration-300"
    id="mobile-drawer"
  >
    <nav
      class="flex flex-col gap-4 text-[13px] tracking-[0.16em] uppercase font-medium text-black"
    >
      {navLinks.map((link) => (
        <a href={link.href} class="py-2 border-b border-atelier-teal/5 hover:text-champagne transition-colors mobile-nav-item">
          {link.label}
        </a>
      ))}
      <a
        class="py-2 border-b border-atelier-teal/5 text-champagne mobile-nav-item"
        href="/login"
      >
        Client Sign In / Register
      </a>
    </nav>
  </div>
</header>

<script>
  import { authClient } from "../lib/auth-client";

  // Elements
  const navGuestState = document.getElementById("nav-guest-state");
  const navUserState = document.getElementById("nav-user-state");
  const userInitials = document.getElementById("user-initials");
  const userNameDisplay = document.getElementById("user-name-display");
  const dropdownUserName = document.getElementById("dropdown-user-name");
  const dropdownUserEmail = document.getElementById("dropdown-user-email");
  const avatarButton = document.getElementById("avatar-menu-button");
  const userDropdown = document.getElementById("user-dropdown-menu");
  const signoutTrigger = document.getElementById("signout-trigger");
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileDrawer = document.getElementById("mobile-drawer");
  const mobileNavItems = document.querySelectorAll(".mobile-nav-item");

  // Toggle user dropdown
  avatarButton?.addEventListener("click", (e) => {
    e.stopPropagation();
    userDropdown?.classList.toggle("hidden");
  });

  // Close dropdown on outside click
  document.addEventListener("click", () => {
    if (!userDropdown?.classList.contains("hidden")) {
      userDropdown?.classList.add("hidden");
    }
  });

  // Mobile menu toggle
  mobileMenuButton?.addEventListener("click", () => {
    mobileDrawer?.classList.toggle("hidden");
  });

  mobileNavItems.forEach((item) => {
    item.addEventListener("click", () => {
      mobileDrawer?.classList.add("hidden");
    });
  });

  // Check auth session
  async function verifySession() {
    try {
      const { data: session } = await authClient.getSession();
      if (session?.user) {
        navGuestState?.classList.add("hidden");
        navUserState?.classList.remove("hidden");

        const name = session.user.name || "Traveler";
        const email = session.user.email || "";
        const initial = name.charAt(0).toUpperCase();

        if (userInitials) {
          userInitials.textContent = initial;
        }
        if (userNameDisplay) {
          userNameDisplay.textContent = name;
        }
        if (dropdownUserName) {
          dropdownUserName.textContent = name;
        }
        if (dropdownUserEmail) {
          dropdownUserEmail.textContent = email;
        }
      }
    } catch {
      // Guest mode
    }
  }

  // Handle Sign Out
  signoutTrigger?.addEventListener("click", async () => {
    try {
      await authClient.signOut({
        fetchOptions: {
          onSuccess: () => {
            window.location.href = "/";
          },
        },
      });
    } catch (err) {
      console.error("Sign out error", err);
    }
  });

  verifySession();
</script>
