---
import ApiStatus from "./ApiStatus.astro";
import SubscribeForm from "./SubscribeForm.astro";
---

<footer
  class="bg-atelier-teal-dark text-champagne border-t border-champagne/20 pt-16 pb-12"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-12">
    <!-- Top Row: Newsletter / Gazette Dispatch -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-10 pb-14 border-b border-white/10 items-center"
    >
      <div class="lg:col-span-6">
        <span
          class="text-[10px] uppercase tracking-[0.3em] text-champagne font-semibold block mb-2"
        >
          Private Correspondence
        </span>
        <h3
          class="font-serif text-2xl sm:text-3xl text-champagne font-normal leading-snug"
        >
          The Atelier Gazette:
          <span class="italic text-champagne-light">Quarterly Dispatches</span>
        </h3>
        <p
          class="mt-2 text-xs sm:text-sm text-champagne/70 font-light leading-relaxed max-w-lg"
        >
          Receive confidential updates on newly privatized architectural
          sanctuaries, private aviation windows, and unscripted cultural
          expeditions.
        </p>
      </div>

      <div class="lg:col-span-6">
        <SubscribeForm />
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 py-14 border-b border-champagne/10"
    >
      <!-- Col 1: Brand & Pedigree -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div
            class="flex h-8 w-8 items-center justify-center rounded-full border border-champagne/60 bg-black text-champagne"
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                stroke-linejoin="round"
              />
              <circle cx="12" cy="12" fill="currentColor" r="2" />
            </svg>
          </div>
          <span
            class="font-serif text-lg tracking-[0.16em] font-semibold text-champagne"
          >
            TERRA NOVA ATELIER
          </span>
        </div>
        <p
          class="text-xs text-champagne/70 font-light leading-relaxed max-w-sm mb-6"
        >
          Curators of unscripted expeditions, off-market architectural estates,
          and rare cultural mentorship for sovereign families, collectors, and
          legacy travelers worldwide.
        </p>
        <div class="text-[11px] text-champagne font-mono tracking-wider">
          GENEVA · LONDON · TOKYO · NAIROBI
        </div>
      </div>

      <!-- Col 2: Portfolios -->
      <div>
        <h4
          class="text-[11px] uppercase tracking-[0.2em] font-semibold text-champagne mb-4"
        >
          Portfolios
        </h4>
        <ul class="space-y-2.5 text-xs text-champagne/75 font-light">
          <li>
            <a
              class="hover:text-champagne transition-colors"
              href="#destinations"
              >The Aegean Archipelago</a
            >
          </li>
          <li>
            <a
              class="hover:text-champagne transition-colors"
              href="#destinations"
              >Kyoto Archival Sanctum</a
            >
          </li>
          <li>
            <a
              class="hover:text-champagne transition-colors"
              href="#destinations"
              >Serengeti Private Concession</a
            >
          </li>
          <li>
            <a
              class="hover:text-champagne transition-colors"
              href="#destinations"
              >Patagonian Icefield Retreat</a
            >
          </li>
          <li>
            <a class="hover:text-champagne transition-colors" href="#inquire"
              >Unlisted Bespoke Routes</a
            >
          </li>
        </ul>
      </div>

      <!-- Col 3: The Atelier -->
      <div>
        <h4
          class="text-[11px] uppercase tracking-[0.2em] font-semibold text-champagne mb-4"
        >
          The Atelier
        </h4>
        <ul class="space-y-2.5 text-xs text-champagne/75 font-light">
          <li>
            <a class="hover:text-champagne transition-colors" href="#pillars"
              >Private Aviation Logistics</a
            >
          </li>
          <li>
            <a class="hover:text-champagne transition-colors" href="#pillars"
              >Sanctuary Privatization</a
            >
          </li>
          <li>
            <a class="hover:text-champagne transition-colors" href="#pillars"
              >Archival Cultural Access</a
            >
          </li>
          <li>
            <a class="hover:text-champagne transition-colors" href="/dashboard"
              >Traveler Salon Portal</a
            >
          </li>
          <li>
            <a class="hover:text-champagne transition-colors" href="/login"
              >Client Authentication</a
            >
          </li>
        </ul>
      </div>

      <!-- Col 4: Discretion & Legal -->
      <div>
        <h4
          class="text-[11px] uppercase tracking-[0.2em] font-semibold text-champagne mb-4"
        >
          Swiss Discretion
        </h4>
        <ul class="space-y-2.5 text-xs text-champagne/75 font-light">
          <li>
            <span class="text-white/90 font-medium"
              >Swiss Privacy Standard</span
            >
          </li>
          <li><span>Zero Ad Network Tracking</span></li>
          <li><span>Bilateral NDA Protocols</span></li>
          <li><span>Encrypted Lead Routing</span></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Discrete Server Health Status -->
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-champagne/50"
    >
      <div>
        © {new Date().getFullYear()} Travel Kairos. All rights reserved.
      </div>

      <ApiStatus />
    </div>
  </div>
</footer>
