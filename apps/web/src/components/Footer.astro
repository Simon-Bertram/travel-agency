---
---

<footer
  class="bg-[#072526] text-[#fbf9f6] border-t border-[#c5a880]/20 pt-16 pb-12"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-12">
    <!-- Top Row: Newsletter / Gazette Dispatch -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-10 pb-14 border-b border-white/10 items-center"
    >
      <div class="lg:col-span-6">
        <span
          class="text-[10px] uppercase tracking-[0.3em] text-[#c5a880] font-semibold block mb-2"
        >
          Private Correspondence
        </span>
        <h3
          class="font-serif text-2xl sm:text-3xl text-[#fbf9f6] font-normal leading-snug"
        >
          The Atelier Gazette:
          <span class="italic text-[#e6d7c3]">Quarterly Dispatches</span>
        </h3>
        <p
          class="mt-2 text-xs sm:text-sm text-[#fbf9f6]/70 font-light leading-relaxed max-w-lg"
        >
          Receive confidential updates on newly privatized architectural
          sanctuaries, private aviation windows, and unscripted cultural
          expeditions.
        </p>
      </div>

      <div class="lg:col-span-6">
        <form class="flex flex-col sm:flex-row gap-3" id="gazette-form">
          <input
            class="flex-1 rounded-full border border-white/20 bg-white/5 px-5 py-3 text-xs text-white placeholder-white/40 focus:border-[#c5a880] focus:bg-white/10 focus:outline-none transition-all"
            id="gazette-email"
            placeholder="principal@estate.ch"
            required
            type="email"
          >
          <button
            class="rounded-full bg-[#c5a880] px-7 py-3 text-xs font-semibold uppercase tracking-[0.18em] text-[#0c3a3b] hover:bg-[#dfcaa8] transition-colors whitespace-nowrap"
            type="submit"
          >
            Subscribe
          </button>
        </form>
        <p
          class="hidden text-xs text-[#c5a880] mt-2 font-light"
          id="gazette-success"
        >
          ✓ Your correspondence address has been discreetly enrolled in the
          Atelier Gazette.
        </p>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 py-14 border-b border-white/10"
    >
      <!-- Col 1: Brand & Pedigree -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div
            class="flex h-8 w-8 items-center justify-center rounded-full border border-[#c5a880]/60 bg-[#0c3a3b] text-[#c5a880]"
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                stroke-linejoin="round"
              />
              <circle cx="12" cy="12" fill="currentColor" r="2" />
            </svg>
          </div>
          <span
            class="font-serif text-lg tracking-[0.16em] font-semibold text-[#fbf9f6]"
          >
            TERRA NOVA ATELIER
          </span>
        </div>
        <p
          class="text-xs text-[#fbf9f6]/70 font-light leading-relaxed max-w-sm mb-6"
        >
          Curators of unscripted expeditions, off-market architectural estates,
          and rare cultural mentorship for sovereign families, collectors, and
          legacy travelers worldwide.
        </p>
        <div class="text-[11px] text-[#c5a880] font-mono tracking-wider">
          GENEVA · LONDON · TOKYO · NAIROBI
        </div>
      </div>

      <!-- Col 2: Portfolios -->
      <div>
        <h4
          class="text-[11px] uppercase tracking-[0.2em] font-semibold text-[#c5a880] mb-4"
        >
          Portfolios
        </h4>
        <ul class="space-y-2.5 text-xs text-[#fbf9f6]/75 font-light">
          <li>
            <a
              class="hover:text-[#c5a880] transition-colors"
              href="#destinations"
              >The Aegean Archipelago</a
            >
          </li>
          <li>
            <a
              class="hover:text-[#c5a880] transition-colors"
              href="#destinations"
              >Kyoto Archival Sanctum</a
            >
          </li>
          <li>
            <a
              class="hover:text-[#c5a880] transition-colors"
              href="#destinations"
              >Serengeti Private Concession</a
            >
          </li>
          <li>
            <a
              class="hover:text-[#c5a880] transition-colors"
              href="#destinations"
              >Patagonian Icefield Retreat</a
            >
          </li>
          <li>
            <a class="hover:text-[#c5a880] transition-colors" href="#inquire"
              >Unlisted Bespoke Routes</a
            >
          </li>
        </ul>
      </div>

      <!-- Col 3: The Atelier -->
      <div>
        <h4
          class="text-[11px] uppercase tracking-[0.2em] font-semibold text-[#c5a880] mb-4"
        >
          The Atelier
        </h4>
        <ul class="space-y-2.5 text-xs text-[#fbf9f6]/75 font-light">
          <li>
            <a class="hover:text-[#c5a880] transition-colors" href="#pillars"
              >Private Aviation Logistics</a
            >
          </li>
          <li>
            <a class="hover:text-[#c5a880] transition-colors" href="#pillars"
              >Sanctuary Privatization</a
            >
          </li>
          <li>
            <a class="hover:text-[#c5a880] transition-colors" href="#pillars"
              >Archival Cultural Access</a
            >
          </li>
          <li>
            <a class="hover:text-[#c5a880] transition-colors" href="/dashboard"
              >Traveler Salon Portal</a
            >
          </li>
          <li>
            <a class="hover:text-[#c5a880] transition-colors" href="/login"
              >Client Authentication</a
            >
          </li>
        </ul>
      </div>

      <!-- Col 4: Discretion & Legal -->
      <div>
        <h4
          class="text-[11px] uppercase tracking-[0.2em] font-semibold text-[#c5a880] mb-4"
        >
          Swiss Discretion
        </h4>
        <ul class="space-y-2.5 text-xs text-[#fbf9f6]/75 font-light">
          <li>
            <span class="text-white/90 font-medium"
              >Swiss Privacy Standard</span
            >
          </li>
          <li><span>Zero Ad Network Tracking</span></li>
          <li><span>Bilateral NDA Protocols</span></li>
          <li><span>Encrypted Lead Routing</span></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Discrete Server Health Status -->
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-[#fbf9f6]/50"
    >
      <div>
        © {new Date().getFullYear()} Terra Nova Atelier. All rights reserved.
        Registered in Switzerland.
      </div>

      <!-- Server / oRPC API Status badge -->
      <div class="flex items-center gap-2" id="footer-api-status">
        <span class="h-2 w-2 rounded-full bg-orange-400" id="status-dot"></span>
        <span id="status-text">Connecting to Concierge Server...</span>
      </div>
    </div>
  </div>
</footer>

<script>
  import { orpc } from "../lib/orpc";

  // Gazette subscription mock handler
  const gazetteForm = document.getElementById("gazette-form");
  const gazetteSuccess = document.getElementById("gazette-success");

  gazetteForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    gazetteSuccess?.classList.remove("hidden");
    const input = document.getElementById(
      "gazette-email"
    ) as unknown as HTMLInputElement;
    if (input) {
      input.value = "";
    }
  });

  // Background health check from oRPC
  const statusDot = document.getElementById("status-dot");
  const statusText = document.getElementById("status-text");

  async function checkServerHealth() {
    try {
      await orpc.healthCheck();
      if (statusDot) {
        statusDot.className =
          "h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]";
      }
      if (statusText) {
        statusText.textContent = "Concierge Network Online";
      }
    } catch {
      if (statusDot) {
        statusDot.className = "h-2 w-2 rounded-full bg-amber-400";
      }
      if (statusText) {
        statusText.textContent = "Concierge Standby";
      }
    }
  }

  checkServerHealth();
</script>
