---
---

<section
  class="py-24 bg-[#f5f3f0] border-b border-[#e6e0d6] relative overflow-hidden"
>
  <div class="mx-auto max-w-5xl px-6 lg:px-12 text-center relative z-10">
    <!-- Archival Seal Icon -->
    <div
      class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-[#c5a880]/60 bg-white text-[#c5a880] mb-8 shadow-sm"
    >
      <svg
        aria-hidden="true"
        class="h-6 w-6"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z"
        />
      </svg>
    </div>

    <!-- Editorial Quote -->
    <blockquote
      class="font-serif text-2xl sm:text-3xl md:text-4xl text-[#0c3a3b] font-normal leading-relaxed tracking-tight max-w-4xl mx-auto mb-10"
    >
      “Terra Nova Atelier unlocked doors in Kyoto and the Peloponnese that we
      were told were
      <span
        class="italic text-[#164f51] underline decoration-[#c5a880]/50 decoration-1 underline-offset-8"
        >permanently closed to the world</span
      >. Their discretion, archival depth, and logistical mastery are without
      peer.”
    </blockquote>

    <!-- Client Signature & Credential -->
    <div class="flex flex-col items-center gap-1.5">
      <p
        class="text-sm font-semibold tracking-[0.2em] uppercase text-[#0c3a3b]"
      >
        Eleanor & Marcus Vance
      </p>
      <p class="text-xs text-[#0c3a3b]/60 tracking-wider">
        Private Collectors & Family Office Principals · Geneva & London
      </p>
      <div
        class="mt-4 inline-flex items-center gap-2 rounded-full border border-[#c5a880]/40 bg-white/80 px-3 py-1 text-[10px] uppercase tracking-widest text-[#c5a880] font-medium"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#c5a880]"></span>
        Verified Private Commission
      </div>
    </div>
  </div>
</section>
