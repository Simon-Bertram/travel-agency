<!-- Floating Itinerary Quick-Filter Bar -->
<div
  class="w-full max-w-4xl rounded-2xl border border-champagne/30 bg-atelier-teal/85 p-3.5 sm:p-5 backdrop-blur-xl shadow-2xl"
>
  <form
    class="grid grid-cols-1 gap-3 sm:grid-cols-4 sm:gap-4 items-center"
    id="hero-filter-form"
  >
    <!-- Region Dropdown -->
    <div class="flex flex-col text-left px-2">
      <label
        class="text-[10px] uppercase tracking-[0.2em] text-champagne font-semibold mb-1"
        for="filter-region"
      >
        Region
      </label>
      <select
        class="w-full bg-transparent text-xs text-champagne focus:outline-none cursor-pointer border-b border-white/20 pb-1 hover:border-champagne"
        id="filter-region"
      >
        <option class="bg-atelier-teal text-white" value="all">
          All Global Regions
        </option>
        <option class="bg-atelier-teal text-white" value="aegean">
          Aegean & Mediterranean
        </option>
        <option class="bg-atelier-teal text-white" value="kyoto">
          Kyoto & Hokkaido
        </option>
        <option class="bg-atelier-teal text-white" value="serengeti">
          Serengeti & East Africa
        </option>
        <option class="bg-atelier-teal text-white" value="patagonia">
          Patagonia & Polar Fjord
        </option>
      </select>
    </div>

    <!-- Season Dropdown -->
    <div class="flex flex-col text-left px-2">
      <label
        class="text-[10px] uppercase tracking-[0.2em] text-champagne font-semibold mb-1"
        for="filter-season"
      >
        Seasonal Window
      </label>
      <select
        class="w-full bg-transparent text-xs text-champagne focus:outline-none cursor-pointer border-b border-white/20 pb-1 hover:border-champagne"
        id="filter-season"
      >
        <option class="bg-atelier-teal text-white" value="all">
          Any Season
        </option>
        <option class="bg-atelier-teal text-white" value="spring">
          Spring Equinox
        </option>
        <option class="bg-atelier-teal text-white" value="summer">
          High Summer
        </option>
        <option class="bg-atelier-teal text-white" value="autumn">
          Autumn Harvest
        </option>
        <option class="bg-atelier-teal text-white" value="winter">
          Austral / Polar Winter
        </option>
      </select>
    </div>

    <!-- Style Dropdown -->
    <div class="flex flex-col text-left px-2">
      <label
        class="text-[10px] uppercase tracking-[0.2em] text-champagne font-semibold mb-1"
        for="filter-style"
      >
        Expedition Tier
      </label>
      <select
        class="w-full bg-transparent text-xs text-champagne focus:outline-none cursor-pointer border-b border-white/20 pb-1 hover:border-champagne"
        id="filter-style"
      >
        <option class="bg-atelier-teal text-white" value="all">
          All Expedition Types
        </option>
        <option class="bg-atelier-teal text-white" value="yacht">
          Private Marine Charter
        </option>
        <option class="bg-atelier-teal text-white" value="sanctuary">
          Archival Estate Sanctuary
        </option>
        <option class="bg-atelier-teal text-white" value="cultural">
          Curated Cultural Immersion
        </option>
      </select>
    </div>

    <!-- Quick Filter Trigger Button -->
    <div class="flex items-end pt-1">
      <button
        class="w-full rounded-xl bg-champagne/20 border border-champagne/60 py-2.5 text-xs font-semibold uppercase tracking-[0.18em] text-champagne transition-all duration-300 hover:bg-champagne hover:text-black"
        type="submit"
      >
        Filter Itineraries
      </button>
    </div>
  </form>
</div>

<script>
  const filterForm = document.getElementById("hero-filter-form");

  filterForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const regionSelect = document.getElementById(
      "filter-region"
    ) as unknown as HTMLSelectElement;
    const seasonSelect = document.getElementById(
      "filter-season"
    ) as unknown as HTMLSelectElement;
    const styleSelect = document.getElementById(
      "filter-style"
    ) as unknown as HTMLSelectElement;

    const filterEvent = new CustomEvent("filter-itineraries", {
      detail: {
        region: regionSelect?.value || "all",
        season: seasonSelect?.value || "all",
        style: styleSelect?.value || "all",
      },
    });
    window.dispatchEvent(filterEvent);

    // Smooth scroll down to itineraries
    const target = document.getElementById("destinations");
    target?.scrollIntoView({ behavior: "smooth" });
  });
</script>
