---
import AtelierPillars from "../components/AtelierPillars.astro";
import Hero from "../components/Hero.astro";
import ItineraryShowcase from "../components/ItineraryShowcase.astro";
import LookbookModal from "../components/LookbookModal.astro";
import PrivateCommissionForm from "../components/PrivateCommissionForm.astro";
import Testimonial from "../components/Testimonial.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  description="Travel Agency for the modern traveler."
  title="Travel Kairos — Travel Agency"
>
  <!-- 1. Full-width Cinematic Hero with Lookbook trigger & Floating Itinerary Filter -->
  <Hero />

  <!-- 2. Handcrafted Itinerary Showcases (Aegean, Kyoto, Serengeti, Patagonia) -->
  <ItineraryShowcase />

  <!-- 3. The Three Atelier Pillars (Private Aviation, Exclusive Sanctuaries, Cultural Immersion) -->
  <AtelierPillars />

  <!-- 4. Client Testimonial (Eleanor & Marcus Vance) -->
  <Testimonial />

  <!-- 5. Private Commission / Lead Traveler Intake Form with Swiss Privacy Guarantee -->
  <PrivateCommissionForm />

  <!-- 6. Interactive Digital Lookbook Modal -->
  <LookbookModal />
</Layout>
