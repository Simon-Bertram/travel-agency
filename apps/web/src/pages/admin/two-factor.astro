---
import StaffAuthLayout from "../../layouts/StaffAuthLayout.astro";
---

<StaffAuthLayout
  description="Enter your authenticator code to finish signing in."
  title="Two-factor verification — Travel Kairos"
>
  <div class="mx-auto w-full max-w-md px-6 py-16">
    <div
      class="rounded-3xl border border-parchment-border bg-alabaster-card p-8 shadow-lg sm:p-10"
    >
      <div class="mb-8 text-center">
        <div class="mb-3 inline-flex items-center gap-2">
          <span class="h-px w-6 bg-champagne"></span>
          <span
            class="text-[11px] font-semibold uppercase tracking-[0.25em] text-champagne"
          >
            Second factor
          </span>
          <span class="h-px w-6 bg-champagne"></span>
        </div>
        <h1
          class="font-serif text-3xl font-normal tracking-tight text-atelier-teal"
        >
          Verify your identity
        </h1>
        <p class="mt-3 text-sm font-light leading-relaxed text-atelier-teal/70">
          Enter the 6-digit code from your authenticator app, or a backup code.
        </p>
      </div>

      <form class="space-y-6" id="totp-form">
        <div>
          <label
            class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-atelier-teal"
            for="totp-code"
          >
            Authenticator code
          </label>
          <input
            autocomplete="one-time-code"
            class="w-full rounded-xl border border-atelier-teal/50 bg-alabaster px-4 py-3 text-center text-lg tracking-[0.4em] text-atelier-teal focus-visible:border-champagne-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-atelier-teal"
            id="totp-code"
            inputmode="numeric"
            maxlength="8"
            name="code"
            placeholder="000000"
            required
          >
        </div>
        <p
          aria-live="assertive"
          class="hidden text-sm font-medium text-rose-700"
          id="totp-error"
          role="alert"
        ></p>
        <button
          class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-atelier-teal px-8 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-alabaster disabled:opacity-50"
          id="totp-submit"
          type="submit"
        >
          Verify
        </button>
      </form>

      <form
        class="mt-8 space-y-4 border-t border-parchment-border pt-8"
        id="backup-form"
      >
        <label
          class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-atelier-teal"
          for="backup-code"
        >
          Backup code
        </label>
        <input
          class="w-full rounded-xl border border-atelier-teal/50 bg-alabaster px-4 py-3 text-sm text-atelier-teal focus-visible:border-champagne-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-atelier-teal"
          id="backup-code"
          name="backupCode"
          placeholder="Enter a one-time backup code"
        >
        <button
          class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-atelier-teal px-8 py-3 text-xs font-semibold uppercase tracking-[0.18em] text-atelier-teal"
          type="submit"
        >
          Use backup code
        </button>
      </form>
    </div>
  </div>
</StaffAuthLayout>

<script>
  import { authClient } from "../../lib/auth-client";

  const totpForm = document.getElementById("totp-form");
  const backupForm = document.getElementById("backup-form");
  const totpInput = document.getElementById("totp-code");
  const backupInput = document.getElementById("backup-code");
  const totpError = document.getElementById("totp-error");
  const totpSubmit = document.getElementById("totp-submit");

  function setError(message: string | null) {
    if (!(totpError instanceof HTMLParagraphElement)) {
      return;
    }
    if (message) {
      totpError.textContent = message;
      totpError.classList.remove("hidden");
      return;
    }
    totpError.textContent = "";
    totpError.classList.add("hidden");
  }

  totpForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    setError(null);
    if (!(totpInput instanceof HTMLInputElement)) {
      return;
    }
    if (totpSubmit instanceof HTMLButtonElement) {
      totpSubmit.disabled = true;
    }

    const { error } = await authClient.twoFactor.verifyTotp({
      code: totpInput.value.trim(),
      trustDevice: false,
    });

    if (totpSubmit instanceof HTMLButtonElement) {
      totpSubmit.disabled = false;
    }

    if (error) {
      setError("Invalid authenticator code. Try again.");
      return;
    }

    window.location.assign("/admin");
  });

  backupForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    setError(null);
    if (!(backupInput instanceof HTMLInputElement)) {
      return;
    }

    const { error } = await authClient.twoFactor.verifyBackupCode({
      code: backupInput.value.trim(),
    });

    if (error) {
      setError("Invalid backup code. Try again.");
      return;
    }

    window.location.assign("/admin");
  });
</script>
