---
import StaffAuthLayout from "../../layouts/StaffAuthLayout.astro";
---

<StaffAuthLayout
  description="Enroll an authenticator app before using the staff portal."
  title="Set up 2FA — Travel Kairos"
>
  <div class="mx-auto w-full max-w-md px-6 py-16">
    <div
      class="rounded-3xl border border-parchment-border bg-alabaster-card p-8 shadow-lg sm:p-10"
    >
      <div class="mb-8 text-center">
        <div class="mb-3 inline-flex items-center gap-2">
          <span class="h-px w-6 bg-champagne"></span>
          <span
            class="text-[11px] font-semibold uppercase tracking-[0.25em] text-champagne"
          >
            Required 2FA
          </span>
          <span class="h-px w-6 bg-champagne"></span>
        </div>
        <h1
          class="font-serif text-3xl font-normal tracking-tight text-atelier-teal"
        >
          Protect this account
        </h1>
        <p class="mt-3 text-sm font-light leading-relaxed text-atelier-teal/70">
          Travel agents must enroll an authenticator app before opening the
          portal.
        </p>
      </div>

      <form class="space-y-6" id="enable-form">
        <div>
          <label
            class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-atelier-teal"
            for="enable-password"
          >
            Confirm password
          </label>
          <input
            autocomplete="current-password"
            class="w-full rounded-xl border border-atelier-teal/50 bg-alabaster px-4 py-3 text-sm text-atelier-teal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-atelier-teal"
            id="enable-password"
            name="password"
            required
            type="password"
          >
        </div>
        <p
          aria-live="assertive"
          class="hidden text-sm font-medium text-rose-700"
          id="setup-error"
          role="alert"
        ></p>
        <button
          class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-atelier-teal px-8 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-alabaster disabled:opacity-50"
          id="enable-submit"
          type="submit"
        >
          Generate QR code
        </button>
      </form>

      <div class="mt-8 hidden space-y-6" id="enroll-panel">
        <div class="flex justify-center" id="qr-target"></div>
        <p class="text-sm font-light text-atelier-teal/70">
          Scan this code in your authenticator app, then store these backup
          codes somewhere safe. They will not be shown again.
        </p>
        <ul
          class="grid grid-cols-2 gap-2 rounded-xl bg-alabaster p-4 font-mono text-xs text-atelier-teal"
          id="backup-codes"
        ></ul>
        <form class="space-y-4" id="verify-form">
          <label
            class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.16em] text-atelier-teal"
            for="enroll-code"
          >
            Authenticator code
          </label>
          <input
            autocomplete="one-time-code"
            class="w-full rounded-xl border border-atelier-teal/50 bg-alabaster px-4 py-3 text-center text-lg tracking-[0.4em] text-atelier-teal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-atelier-teal"
            id="enroll-code"
            inputmode="numeric"
            maxlength="8"
            required
          >
          <button
            class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-atelier-teal px-8 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-alabaster"
            type="submit"
          >
            Confirm and continue
          </button>
        </form>
      </div>
    </div>
  </div>
</StaffAuthLayout>

<script>
  import { hasStaffRole } from "@travel-kairos/auth/permissions";
  import { authClient, readAuthSession } from "../../lib/auth-client";
  import { totpQrSvg } from "../../lib/qr";
  import { destinationAfterSignIn } from "../../lib/staff-session";

  const enableForm = document.getElementById("enable-form");
  const verifyForm = document.getElementById("verify-form");
  const passwordInput = document.getElementById("enable-password");
  const enrollCodeInput = document.getElementById("enroll-code");
  const enableSubmit = document.getElementById("enable-submit");
  const setupError = document.getElementById("setup-error");
  const enrollPanel = document.getElementById("enroll-panel");
  const qrTarget = document.getElementById("qr-target");
  const backupCodesList = document.getElementById("backup-codes");

  function setError(message: string | null) {
    if (!(setupError instanceof HTMLParagraphElement)) {
      return;
    }
    if (message) {
      setupError.textContent = message;
      setupError.classList.remove("hidden");
      return;
    }
    setupError.textContent = "";
    setupError.classList.add("hidden");
  }

  const session = await readAuthSession();
  if (!session?.user) {
    window.location.assign("/admin/login");
  } else if (!hasStaffRole(session.user.role)) {
    window.location.assign("/dashboard");
  } else if (session.user.twoFactorEnabled) {
    window.location.assign(destinationAfterSignIn(session.user));
  }

  enableForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    setError(null);
    if (!(passwordInput instanceof HTMLInputElement)) {
      return;
    }
    if (enableSubmit instanceof HTMLButtonElement) {
      enableSubmit.disabled = true;
    }

    const { data, error } = await authClient.twoFactor.enable({
      method: "totp",
      password: passwordInput.value,
    });

    if (enableSubmit instanceof HTMLButtonElement) {
      enableSubmit.disabled = false;
    }

    if (error || !data || data.method !== "totp") {
      setError("Could not start 2FA enrollment. Check your password.");
      return;
    }

    if (qrTarget) {
      qrTarget.innerHTML = totpQrSvg(data.totpURI);
    }

    if (backupCodesList) {
      backupCodesList.replaceChildren();
      for (const code of data.backupCodes) {
        const item = document.createElement("li");
        item.textContent = code;
        backupCodesList.appendChild(item);
      }
    }

    enableForm.classList.add("hidden");
    enrollPanel?.classList.remove("hidden");
  });

  verifyForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    setError(null);
    if (!(enrollCodeInput instanceof HTMLInputElement)) {
      return;
    }

    const { error } = await authClient.twoFactor.verifyTotp({
      code: enrollCodeInput.value.trim(),
      trustDevice: false,
    });

    if (error) {
      setError("That code was not accepted. Try the next one from the app.");
      return;
    }

    window.location.assign("/admin");
  });
</script>
